# ── DevFlow environment ──────────────────────────────────────
# Copy to .env and adjust. NEVER commit .env.

# SQLite (default — zero setup, great for local dev)
DATABASE_URL="file:./devflow.db"

# PostgreSQL (docker compose up db) — also switch provider in prisma/schema.prisma
# DATABASE_URL="postgresql://devflow:devflow@localhost:5432/devflow"

# JWT signing secret — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Port used by `npm start` / Docker
PORT=3000

# ── White-label branding (rebrand the app without touching the code) ───
# NEXT_PUBLIC_APP_NAME="DevFlow"
# NEXT_PUBLIC_APP_TAGLINE="Full-stack kanban SaaS — plan it, drag it, ship it."
# NEXT_PUBLIC_APP_DESCRIPTION="A clean, production-ready kanban."

# Session cookie "Secure" flag — false for local http://localhost testing,
# true (or unset) behind HTTPS in production
COOKIE_SECURE=false
